{
    "name": "liveintent/laravel-prometheus-exporter",
    "description": "Prometheus exporter for laravel metrics.",
    "keywords": [
        "liveintent",
        "laravel",
        "prometheus",
        "exporter"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^2.46",
        "promphp/prometheus_client_php": "^2.2"
    },
    "require-dev": {
        "brianium/paratest": "^v6.2",
        "liveintent/php-cs-fixer": "^2.0",
        "nunomaduro/collision": "^v5.3",
        "orchestra/testbench": "^v6.15",
        "phpunit/phpunit": "^9.3",
        "vimeo/psalm": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "LiveIntent\\LaravelPrometheusExporter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiveIntent\\LaravelPrometheusExporter\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "./vendor/bin/testbench package:test --parallel --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "liveintent/*": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LiveIntent\\LaravelPrometheusExporter\\LaravelPrometheusExporterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
